# App mode
LLM_PROVIDER=mock

# OpenAI-compatible mode
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# Azure OpenAI mode
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=500

# Guardrails
REDACT_BEFORE_CLOUD=true
MAX_INPUT_CHARS=3000
RETRIEVAL_TOP_K=3

# Logging
PROMPT_VERSION=v1
