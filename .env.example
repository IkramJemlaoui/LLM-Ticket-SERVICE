# Free local real LLM mode (default; no API key or per-request charge)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:latest
# Placeholder required by the OpenAI-compatible client; Ollama ignores it.
OLLAMA_API_KEY=ollama

# Optional OpenAI cloud mode (set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

# Other OpenAI-compatible endpoint (set LLM_PROVIDER=openai_compatible)
LLM_BASE_URL=https://your-approved-provider.example/v1
LLM_API_KEY=
LLM_MODEL=your-model-id

# Azure OpenAI mode
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Generation settings
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=180
ALLOW_MOCK_FALLBACK=false

# Guardrails
REDACT_BEFORE_CLOUD=true
MAX_INPUT_CHARS=3000
RETRIEVAL_TOP_K=3
RETRIEVAL_MIN_SCORE=0.08

# Agentic workflow controls
MAX_AGENT_STEPS=6
REQUIRE_HUMAN_APPROVAL=true

# Logging
PROMPT_VERSION=v1
